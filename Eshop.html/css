<!-- TOAST -->
<div class="toast" id="toast"></div>

<script>

// =================================
// VIBE MART SHOPPING SYSTEM
// =================================

// LOAD SAVED CART

let cart = {};

try {
    const savedCart = JSON.parse(
        localStorage.getItem("vibeMartCart")
    );

    if (savedCart && typeof savedCart === "object" &&
        !Array.isArray(savedCart)) {
        cart = savedCart;
    }
} catch (error) {
    cart = {};
}

// SELECT ELEMENTS

const cartButton = document.getElementById("cartButton");
const cartModal = document.getElementById("cartModal");
const closeCart = document.getElementById("closeCart");
const cartItems = document.getElementById("cartItems");
const totalPrice = document.getElementById("totalPrice");
const checkoutButton = document.getElementById("checkoutButton");
const toast = document.getElementById("toast");

// FORMAT PRICE

function formatPrice(amount) {
    return "₹" + amount.toLocaleString("en-IN");
}

// SHOW MESSAGE

let toastTimer;

function showToast(message) {

    toast.textContent = message;
    toast.classList.add("show");

    clearTimeout(toastTimer);

    toastTimer = setTimeout(() => {
        toast.classList.remove("show");
    }, 2200);

}

// SAVE CART

function saveCart() {

    localStorage.setItem(
        "vibeMartCart",
        JSON.stringify(cart)
    );

}

// UPDATE CART COUNT

function updateCartCount() {

    const count = Object.values(cart).reduce(
        (total, item) => total + item.quantity,
        0
    );

    cartButton.textContent = `🛒 Cart (${count})`;

}

// ADD PRODUCTS TO CART

document.querySelectorAll(".product-card").forEach(card => {

    const button = card.querySelector(".add-btn");

    button.addEventListener("click", () => {

        const name = card.querySelector("h3").textContent;

        const price = Number(
            card.querySelector(".price")
                .textContent.replace(/[₹,]/g, "")
        );

        const image = card.querySelector("img").src;

        if (cart[name]) {

            cart[name].quantity++;

        } else {

            cart[name] = {
                name: name,
                price: price,
                image: image,
                quantity: 1
            };

        }

        saveCart();
        updateCartCount();

        button.textContent = "✓ Added!";

        showToast("🎉 " + name + " added to cart!");

        setTimeout(() => {
            button.textContent = "+ Add to Cart";
        }, 1000);

    });

});

// DISPLAY CART

function renderCart() {

    cartItems.replaceChildren();

    let total = 0;

    const entries = Object.entries(cart);

    if (entries.length === 0) {

        const empty = document.createElement("div");

        empty.className = "empty-cart";
        empty.textContent = "🛍️ Your cart is empty! Start shopping.";

        cartItems.appendChild(empty);

    }

    entries.forEach(([name, item]) => {

        const row = document.createElement("div");
        row.className = "cart-item";

        const image = document.createElement("img");
        image.src = item.image;
        image.alt = name;

        const info = document.createElement("div");
        info.className = "cart-item-info";

        const title = document.createElement("h4");
        title.textContent = name;

        const price = document.createElement("p");
        price.textContent = formatPrice(
            item.price * item.quantity
        );

        const controls = document.createElement("div");
        controls.className = "quantity-controls";

        const minus = document.createElement("button");
        minus.textContent = "−";
        minus.dataset.action = "decrease";
        minus.dataset.name = name;
        minus.setAttribute("aria-label", "Decrease quantity");

        const quantity = document.createElement("span");
        quantity.textContent = item.quantity;

        const plus = document.createElement("button");
        plus.textContent = "+";
        plus.dataset.action = "increase";
        plus.dataset.name = name;
        plus.setAttribute("aria-label", "Increase quantity");

        controls.append(minus, quantity, plus);

        info.append(title, price, controls);

        const remove = document.createElement("button");
        remove.className = "remove-item";
        remove.textContent = "🗑️";
        remove.dataset.action = "remove";
        remove.dataset.name = name;
        remove.setAttribute("aria-label", "Remove " + name);

        row.append(image, info, remove);

        cartItems.appendChild(row);

        total += item.price * item.quantity;

    });

    totalPrice.textContent = formatPrice(total);

    updateCartCount();

}

// CART BUTTON

cartButton.addEventListener("click", () => {

    renderCart();
    cartModal.classList.add("active");

});

// CLOSE CART

closeCart.addEventListener("click", () => {

    cartModal.classList.remove("active");

});

cartModal.addEventListener("click", (event) => {

    if (event.target === cartModal) {
        cartModal.classList.remove("active");
    }

});

document.addEventListener("keydown", (event) => {

    if (event.key === "Escape") {
        cartModal.classList.remove("active");
    }

});

// INCREASE, DECREASE AND REMOVE PRODUCTS

cartItems.addEventListener("click", (event) => {

    const button = event.target.closest("button[data-action]");

    if (!button) return;

    const name = button.dataset.name;
    const action = button.dataset.action;

    if (!cart[name]) return;

    if (action === "increase") {

        cart[name].quantity++;

    }

    else if (action === "decrease") {

        cart[name].quantity--;

        if (cart[name].quantity <= 0) {
            delete cart[name];
        }

    }

    else if (action === "remove") {

        delete cart[name];
        showToast("Product removed from cart!");

    }

    saveCart();
    renderCart();

});

// CATEGORY FILTERING

document.querySelectorAll(".category-card").forEach(category => {

    category.addEventListener("click", () => {

        const selectedCategory = category.dataset.category;

        const alreadyActive =
            category.classList.contains("active-category");

        document.querySelectorAll(".category-card").forEach(card => {
            card.classList.remove("active-category");
        });

        if (alreadyActive) {

            document.querySelectorAll(".product-card").forEach(product => {
                product.hidden = false;
            });

            showToast("Showing all products");

        } else {

            category.classList.add("active-category");

            document.querySelectorAll(".product-card").forEach(product => {

                product.hidden =
                    product.dataset.category !== selectedCategory;

            });

            document.getElementById("products").scrollIntoView({
                behavior: "smooth"
            });

            showToast("Showing " + selectedCategory.toLowerCase());

        }

    });

});

// SHOW ALL PRODUCTS

document.getElementById("showAll").addEventListener("click", () => {

    document.querySelectorAll(".product-card").forEach(product => {
        product.hidden = false;
    });

    document.querySelectorAll(".category-card").forEach(category => {
        category.classList.remove("active-category");
    });

    showToast("All products are now visible!");

});

// CHECKOUT DEMO

checkoutButton.addEventListener("click", () => {

    const items = Object.values(cart);

    if (items.length === 0) {

        showToast("Your cart is empty!");

        return;

    }

    const total = items.reduce(
        (sum, item) => sum + item.price * item.quantity,
        0
    );

    const itemCount = items.reduce(
        (sum, item) => sum + item.quantity,
        0
    );

    const confirmed = confirm(
        "🎉 VIBE MART - ORDER SUMMARY\n\n" +
        "Total Products: " + itemCount +
        "\nTotal Amount: " + formatPrice(total) +
        "\n\nConfirm your demo order?"
    );

    if (confirmed) {

        alert(
            "🎊 CONGRATULATIONS!\n\n" +
            "Your demo order has been placed successfully!\n\n" +
            "Total Amount: " + formatPrice(total) +
            "\n\nThank you for shopping with VIBE MART!"
        );

        cart = {};

        saveCart();
        renderCart();

        cartModal.classList.remove("active");

    }

});

// INITIALIZE WEBSITE

updateCartCount();

console.log("🔥 VIBE MART is ready!");

