`html
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>VIBE MART | Shop Your Vibe</title>

<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Outfit', sans-serif;
    scroll-behavior: smooth;
}

body {
    background: #f8f7ff;
    color: #19152c;
    overflow-x: hidden;
}

/* NAVBAR */
header {
    width: 100%;
    background: rgba(255,255,255,.95);
    backdrop-filter: blur(15px);
    position: sticky;
    top: 0;
    z-index: 100;
    border-bottom: 1px solid #eee;
}

.navbar {
    max-width: 1250px;
    margin: auto;
    padding: 18px 25px;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.logo {
    font-size: 29px;
    font-weight: 900;
    letter-spacing: -1px;
}

.logo span, footer span {
    color: #ff4f36;
}

.nav-links {
    display: flex;
    gap: 30px;
    list-style: none;
}

.nav-links a {
    text-decoration: none;
    color: #302b43;
    font-size: 14px;
    font-weight: 600;
    transition: .3s;
}

.nav-links a:hover {
    color: #ff4f36;
}

.cart {
    background: #211b3b;
    color: white;
    padding: 11px 20px;
    border-radius: 30px;
    border: none;
    font-weight: 700;
    cursor: pointer;
    transition: .3s;
}

.cart:hover {
    background: #ff4f36;
    transform: scale(1.05);
}

/* HERO */
.hero {
    min-height: 580px;
    background: linear-gradient(120deg,#ded5ff,#ffe0d6);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 65px max(calc((100% - 1150px)/2), 5%);
    gap: 35px;
    overflow: hidden;
}

.hero-content {
    animation: slideLeft .8s ease both;
    max-width: 550px;
}

.tag {
    display: inline-block;
    background: white;
    padding: 9px 18px;
    border-radius: 30px;
    color: #ff4f36;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 1px;
    margin-bottom: 25px;
}

.hero h1 {
    font-size: clamp(48px,6vw,78px);
    line-height: 1.02;
    font-weight: 900;
    letter-spacing: -3px;
}

.hero h1 span {
    color: #ff4f36;
}

.hero p {
    margin: 23px 0;
    color: #514b65;
    font-size: 16px;
    line-height: 1.7;
}

.shop-btn {
    display: inline-block;
    background: #211b3b;
    color: white;
    text-decoration: none;
    padding: 15px 30px;
    border-radius: 40px;
    font-weight: 700;
    transition: .3s;
    border: none;
    cursor: pointer;
}

.shop-btn:hover {
    background: #ff4f36;
    transform: translateY(-5px);
}

.hero-image img {
    width: 420px;
    height: 390px;
    object-fit: cover;
    border-radius: 35px;
    transform: rotate(3deg);
    border: 8px solid white;
    box-shadow: 0 25px 50px #40315b35;
    transition: .4s;
}

.hero-image img:hover {
    transform: rotate(0deg) scale(1.04);
}

/* ANIMATIONS */
@keyframes slideLeft {
    from { opacity: 0; transform: translateX(-80px); }
    to { opacity: 1; transform: translateX(0); }
}

@keyframes slideRight {
    from { opacity: 0; transform: translateX(80px); }
    to { opacity: 1; transform: translateX(0); }
}

@keyframes slideUp {
    from { opacity: 0; transform: translateY(50px); }
    to { opacity: 1; transform: translateY(0); }
}

.hero-image {
    animation: slideRight .9s ease both;
}

/* MARQUEE */
.marquee {
    background: #ff4f36;
    color: white;
    padding: 16px 0;
    overflow: hidden;
    white-space: nowrap;
    font-size: 17px;
    font-weight: 800;
}

.marquee div {
    display: inline-block;
    animation: moveText 18s linear infinite;
}

@keyframes moveText {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
}

/* SECTIONS */
section {
    padding: 80px 6%;
}

.heading {
    text-align: center;
    margin-bottom: 45px;
}

.heading small {
    color: #ff4f36;
    font-weight: 800;
    letter-spacing: 3px;
}

.heading h2 {
    font-size: 42px;
    font-weight: 900;
    margin-top: 10px;
}

/* CATEGORIES */
.category-grid {
    max-width: 1200px;
    margin: auto;
    display: grid;
    grid-template-columns: repeat(3,1fr);
    gap: 25px;
}

.category-card {
    min-height: 260px;
    border-radius: 25px;
    padding: 30px;
    position: relative;
    overflow: hidden;
    transition: .4s;
    cursor: pointer;
}

.category-card:hover {
    transform: translateY(-12px);
}

.category-card h3 {
    font-size: 30px;
    font-weight: 900;
}

.category-card p {
    margin-top: 10px;
    color: #514b65;
}

.category-card .emoji {
    font-size: 75px;
    position: absolute;
    right: 20px;
    bottom: 20px;
    transition: .4s;
}

.category-card:hover .emoji {
    transform: rotate(-15deg) scale(1.2);
}

.c1 { background: #ffddd5; }
.c2 { background: #d9f6dd; }
.c3 { background: #e3ddff; }

.category-card.active-category {
    outline: 4px solid #ff4f36;
}

/* PRODUCTS */
.products {
    background: white;
}

.product-grid {
    max-width: 1200px;
    margin: auto;
    display: grid;
    grid-template-columns: repeat(4,1fr);
    gap: 22px;
}

.product-card {
    background: #faf9ff;
    border-radius: 20px;
    overflow: hidden;
    transition: .35s;
    animation: slideUp .7s ease both;
}

.product-card:hover {
