}

.price {
    font-size: 20px;
    font-weight: 900;
    margin-bottom: 15px;
}

.add-btn {
    width: 100%;
    padding: 12px;
    border: none;
    border-radius: 12px;
    background: #211b3b;
    color: white;
    font-weight: 700;
    cursor: pointer;
    transition: .3s;
}

.add-btn:hover {
    background: #ff4f36;
}

.product-card[hidden] {
