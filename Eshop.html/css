}

.cart-total {
    display: flex;
    justify-content: space-between;
    font-size: 21px;
    font-weight: 900;
    padding: 20px 0;
}

.checkout-btn {
    width: 100%;
    padding: 15px;
    border: none;
    border-radius: 12px;
    background: #211b3b;
    color: white;
